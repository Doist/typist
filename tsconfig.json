{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["DOM", "ES2024"],
        "types": ["@testing-library/jest-dom", "vite/client", "vitest/globals"],

        "module": "ESNext",
        "moduleResolution": "bundler",

        "jsx": "react-jsx",

        "esModuleInterop": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,

        "noEmit": true,
        "declaration": true,
        "declarationMap": true,

        "strict": true,
        "skipLibCheck": true
    }
}
